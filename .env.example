# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). Only the anon/public key belongs here — never the
# service_role key, which must stay server-side.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Domain used to build the synthetic resident login addresses
# (villa-343@<domain>). These addresses never receive mail; change this only if
# your Supabase project rejects the default.
# VITE_VILLA_EMAIL_DOMAIN=villa.yesilyakasupilates.com

# Optional. Domain used to build the synthetic admin login addresses
# (<username>@<domain>). Must match migration-004-admin-username.sql.
# VITE_ADMIN_EMAIL_DOMAIN=admin.yesilyakasupilates.com
